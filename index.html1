<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Shree Mobile Care | Mobile Repair Center</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#020708;
    color:#fff;
    overflow-x:hidden;
}

:root{
    --green:#00ffb3;
    --dark:#020708;
    --card:#071312;
    --border:#064f40;
    --gray:#9ba9a6;
}

/* NAVBAR */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:70px;
    z-index:1000;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 8%;
    background:rgba(2,7,8,.9);
    backdrop-filter:blur(12px);
    border-bottom:1px solid #123b34;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:22px;
    font-weight:bold;
}

.logo-icon{
    color:var(--green);
    font-size:35px;
}

.logo span{
    color:var(--green);
}

.logo small{
    display:block;
    font-size:9px;
    letter-spacing:3px;
    color:#aaa;
}

.nav-links{
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    color:#ddd;
    text-decoration:none;
    font-size:14px;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--green);
}

.nav-btn{
    background:var(--green);
    color:#00100c;
    padding:11px 20px;
    border-radius:25px;
    text-decoration:none;
    font-weight:bold;
    font-size:13px;
}

/* HERO */

.hero{
    min-height:100vh;
    padding:130px 8% 70px;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 80% 40%,rgba(0,255,179,.18),transparent 30%),
        radial-gradient(circle at 20% 50%,rgba(0,255,179,.08),transparent 30%),
        #020708;
}

.hero:before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(0,255,179,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,255,179,.035) 1px,transparent 1px);
    background-size:50px 50px;
}

.hero-content{
    position:relative;
    z-index:2;
    width:52%;
}

.badge{
    display:inline-block;
    padding:8px 17px;
    border:1px solid var(--green);
    border-radius:30px;
    color:var(--green);
    font-size:13px;
    margin-bottom:22px;
}

.hero h1{
    font-size:64px;
    line-height:1.05;
    margin-bottom:15px;
}

.hero h1 span{
    color:var(--green);
    text-shadow:0 0 25px rgba(0,255,179,.45);
}

.subtitle{
    font-size:25px;
    margin-bottom:20px;
}

.subtitle span{
    color:var(--green);
}

.hero p{
    max-width:580px;
    color:#aab5b2;
    font-size:17px;
    line-height:1.8;
    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:14px 28px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.btn-green{
    background:var(--green);
    color:#00100c;
    box-shadow:0 0 25px rgba(0,255,179,.2);
}

.btn-outline{
    border:1px solid var(--green);
    color:var(--green);
}

.btn:hover{
    transform:translateY(-3px);
    box-shadow:0 0 25px rgba(0,255,179,.3);
}

/* PHONE */

.phone-area{
    position:absolute;
    right:6%;
    width:43%;
    height:500px;
    display:flex;
    justify-content:center;
    align-items:center;
}

.glow{
    position:absolute;
    width:380px;
    height:380px;
    border:5px solid rgba(0,255,179,.6);
    border-radius:50%;
    box-shadow:0 0 80px rgba(0,255,179,.25);
}

.phone{
    position:relative;
    width:190px;
    height:370px;
    border:8px solid #222;
    border-radius:30px;
    background:linear-gradient(135deg,#18201f,#050908);
    transform:rotate(-8deg);
    box-shadow:0 0 40px rgba(0,255,179,.2);
}

.phone:before{
    content:"";
    position:absolute;
    top:8px;
    left:50%;
    transform:translateX(-50%);
    width:80px;
    height:18px;
    background:#000;
    border-radius:20px;
}

.phone-screen{
    position:absolute;
    inset:35px 10px 10px;
    border-radius:20px;
    background:
        radial-gradient(circle at 50% 20%,#00ffb3,transparent 5%),
        linear-gradient(145deg,#052c25,#020808);
}

.crack{
    position:absolute;
    top:100px;
    left:25px;
    width:120px;
    height:160px;
    border-left:2px solid #fff;
    transform:rotate(25deg);
    opacity:.7;
}

/* SECTIONS */

section{
    padding:90px 8%;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title .small{
    color:var(--green);
    font-size:12px;
    font-weight:bold;
    letter-spacing:3px;
}

.section-title h2{
    font-size:40px;
    margin:10px 0;
}

.section-title h2 span{
    color:var(--green);
}

.section-title p{
    color:#87928f;
}

/* SERVICES */

.services{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.service{
    padding:28px;
    min-height:170px;
    border:1px solid var(--border);
    background:linear-gradient(145deg,#071513,#030908);
    border-radius:14px;
    transition:.3s;
    position:relative;
}

.service:hover{
    transform:translateY(-7px);
    border-color:var(--green);
    box-shadow:0 0 25px rgba(0,255,179,.1);
}

.service-icon{
    width:50px;
    height:50px;
    border:1px solid var(--green);
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:23px;
    color:var(--green);
    margin-bottom:18px;
}

.service h3{
    margin-bottom:9px;
}

.service p{
    color:#899591;
    font-size:13px;
    line-height:1.6;
}

/* ABOUT */

.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.about-image{
    height:350px;
    border-radius:20px;
    border:1px solid var(--border);
    background:
        radial-gradient(circle,#00ffb3 1px,transparent 2px),
        linear-gradient(135deg,#09231d,#020606);
    background-size:30px 30px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:100px;
    color:var(--green);
    box-shadow:inset 0 0 80px rgba(0,255,179,.08);
}

.about-text h2{
    font-size:38px;
    margin:10px 0 20px;
}

.about-text h2 span{
    color:var(--green);
}

.about-text p{
    color:#9aa6a2;
    line-height:1.9;
    margin-bottom:25px;
}

.features{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.feature{
    color:#ddd;
    font-size:14px;
}

.feature span{
    color:var(--green);
    margin-right:8px;
}

/* STATS */

.stats{
    border-top:1px solid #12352e;
    border-bottom:1px solid #12352e;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    padding:35px 8%;
    background:#030a09;
}

.stat{
    text-align:center;
    border-right:1px solid #174039;
}

.stat:last-child{
    border:none;
}

.stat strong{
    display:block;
    color:var(--green);
    font-size:30px;
}

.stat span{
    color:#899590;
    font-size:13px;
}

/* CONTACT */

.contact-box{
    max-width:950px;
    margin:auto;
    border:1px solid var(--border);
    border-radius:20px;
    padding:45px;
    background:linear-gradient(145deg,#071513,#020706);
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.contact-box h2{
    font-size:35px;
    margin-bottom:15px;
}

.contact-box h2 span{
    color:var(--green);
}

.contact-box p{
    color:#9aa6a2;
    line-height:1.8;
}

.contact-info{
    margin-top:20px;
}

.contact-info div{
    margin:15px 0;
    color:#ccc;
}

.contact-info span{
    color:var(--green);
    margin-right:10px;
}

/* FOOTER */

footer{
    padding:25px 8%;
    border-top:1px solid #12352e;
    display:flex;
    justify-content:space-between;
    color:#697572;
    font-size:13px;
}

footer span{
    color:var(--green);
}

/* MOBILE */

@media(max-width:850px){

    nav{
        padding:0 5%;
    }

    .nav-links{
        display:none;
    }

    .hero{
        padding:120px 6% 60px;
        text-align:center;
    }

    .hero-content{
        width:100%;
    }

    .hero h1{
        font-size:43px;
    }

    .subtitle{
        font-size:20px;
    }

    .hero p{
        font-size:15px;
    }

    .buttons{
        justify-content:center;
    }

    .phone-area{
        display:none;
    }

    .services{
        grid-template-columns:1fr;
    }

    .about{
        grid-template-columns:1fr;
    }

    .about-image{
        height:250px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
        gap:25px;
    }

    .stat{
        border:none;
    }

    .contact-box{
        grid-template-columns:1fr;
        padding:30px 22px;
    }

    footer{
        flex-direction:column;
        gap:10px;
        text-align:center;
    }
}

@media(max-width:450px){

    .logo{
        font-size:17px;
    }

    .nav-btn{
        padding:9px 12px;
        font-size:11px;
    }

    .hero h1{
        font-size:36px;
    }

    section{
        padding:65px 6%;
    }

    .section-title h2{
        font-size:30px;
    }

    .features{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->

<nav>

    <div class="logo">
        <div class="logo-icon">▣</div>
        <div>
            Shree <span>Mobile Care</span>
            <small>MOBILE REPAIR CENTER</small>
        </div>
    </div>

    <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>

    <a class="nav-btn" href="https://wa.me/88017XXXXXXXX">
        WhatsApp Us
    </a>

</nav>


<!-- HERO -->

<header class="hero" id="home">

    <div class="hero-content">

        <div class="badge">
            ⚡ Fast &nbsp; | &nbsp; Reliable &nbsp; | &nbsp; Trusted
        </div>

        <h1>
            Shree <span>Mobile Care</span>
        </h1>

        <div class="subtitle">
            Your Mobile <span>Our Priority</span>
        </div>

        <p>
            আপনার মোবাইলের সমস্যা যত কঠিনই হোক,
            আমাদের অভিজ্ঞ টেকনিশিয়ানদের কাছে থাকছে
            দ্রুত ও নির্ভরযোগ্য সমাধান।
        </p>

        <div class="buttons">

            <a class="btn btn-green" href="tel:017XXXXXXXX">
                ☎ Call Now
            </a>

            <a class="btn btn-outline"
               href="https://wa.me/88017XXXXXXXX">
                ◉ WhatsApp
            </a>

        </div>

    </div>


    <div class="phone-area">

        <div class="glow"></div>

        <div class="phone">

            <div class="phone-screen">
                <div class="crack"></div>
            </div>

        </div>

    </div>

</header>


<!-- SERVICES -->

<section id="services">

    <div class="section-title">

        <div class="small">OUR SERVICES</div>

        <h2>
            Our Expert <span>Services</span>
        </h2>

        <p>
            আপনার ফোনের জন্য প্রয়োজনীয় সব ধরনের সার্ভিস
        </p>

    </div>


    <div class="services">

        <div class="service">

            <div class="service-icon">📱</div>

            <h3>Display Repair</h3>

            <p>
                Broken বা damaged display পরিবর্তন
                এবং touch সমস্যার সমাধান।
            </p>

        </div>


        <div class="service">

            <div class="service-icon">🔋</div>

            <h3>Battery Service</h3>

            <p>
                Battery backup কমে গেলে battery checking
                ও replacement service।
            </p>

        </div>


        <div class="service">

            <div class="service-icon">⚡</div>

            <h3>Charging Problem</h3>

            <p>
                Charging না হওয়া, slow charging এবং
                charging port repair।
            </p>

        </div>


        <div class="service">

            <div class="service-icon">⚙</div>

            <h3>Hardware Repair</h3>

            <p>
                Motherboard ও অন্যান্য hardware
                সমস্যার professional repair।
            </p>

        </div>


        <div class="service">

            <div class="service-icon">💻</div>

            <h3>Software Service</h3>

            <p>
                Software problem, update, reset
                ও system related service।
            </p>

        </div>


        <div class="service">

            <div class="service-icon">💧</div>

            <h3>Water Damage</h3>

            <p>
                পানিতে ভিজে যাওয়া ফোনের diagnosis
                ও repair service।
            </p>

        </div>

    </div>

</section>


<!-- ABOUT -->

<section id="about">

    <div class="about">

        <div class="about-image">
            ⚙
        </div>


        <div class="about-text">

            <div class="section-title" style="text-align:left;margin-bottom:10px;">
                <div class="small">WHY CHOOSE US?</div>
            </div>

            <h2>
                Why <span>Shree Mobile Care?</span>
            </h2>

            <p>
                Shree Mobile Care-এ আমরা শুধু মোবাইল repair করি না,
                customer-এর বিশ্বাসকেও গুরুত্ব দিই।
                অভিজ্ঞ technician, quality parts এবং পরিষ্কার
                service-এর মাধ্যমে আপনার device নিরাপদে repair
                করার চেষ্টা করি।
            </p>


            <div class="features">

                <div class="feature">
                    <span>✓</span> Experienced Technician
                </div>

                <div class="feature">
                    <span>✓</span> Quality Parts
                </div>

                <div class="feature">
                    <span>✓</span> Quick Service
                </div>

                <div class="feature">
                    <span>✓</span> Customer Satisfaction
                </div>

            </div>

        </div>

    </div>

</section>


<!-- STATS -->

<div class="stats">

    <div class="stat">
        <strong>1000+</strong>
        <span>Happy Customers</span>
    </div>

    <div class="stat">
        <strong>5+</strong>
        <span>Years Experience</span>
    </div>

    <div class="stat">
        <strong>4.9</strong>
        <span>Customer Rating</span>
    </div>

    <div class="stat">
        <strong>24/7</strong>
        <span>Support</span>
    </div>

</div>


<!-- CONTACT -->

<section id="contact">

    <div class="section-title">

        <div class="small">GET IN TOUCH</div>

        <h2>
            Contact <span>Us</span>
        </h2>

        <p>
            আপনার মোবাইলের সমস্যা নিয়ে আমাদের সাথে যোগাযোগ করুন
        </p>

    </div>


    <div class="contact-box">

        <div>

            <h2>
                Shree <span>Mobile Care</span>
            </h2>

            <p>
                আপনার মোবাইল repair-এর জন্য আমাদের সাথে
                সরাসরি যোগাযোগ করুন।
            </p>

            <div class="contact-info">

                <div>
                    <span>☎</span>
                    017XXXXXXXX
                </div>

                <div>
                    <span>📍</span>
                    আপনার দোকানের ঠিকানা এখানে দিন
                </div>

            </div>

        </div>


        <div style="display:flex;align-items:center;justify-content:center;gap:15px;flex-wrap:wrap;">

            <a class="btn btn-green"
               href="https://wa.me/88017XXXXXXXX">
                ◉ WhatsApp Now
            </a>

            <a class="btn btn-outline"
               href="tel:017XXXXXXXX">
                ☎ Call Now
            </a>

        </div>

    </div>

</section>


<!-- FOOTER -->

<footer>

    <div>
        © 2026 <span>Shree Mobile Care</span> — All Rights Reserved.
    </div>

    <div>
        Follow Us ♥
    </div>

</footer>


</body>
</html>
